---
import Base from '../../layouts/Base.astro';
import SplitText from '../../components/SplitText.astro';
import PostRow from '../../components/PostRow.astro';
import { countByCategory, getSummaries } from '../../lib/posts';
import { url, CATEGORIES, CATEGORY_ORDER } from '../../lib/site';

const posts = await getSummaries();
const counts = countByCategory(posts);
---

<Base title="Writing" description="Every note, writeup, project and life log — grouped by topic." path={url('/categories/index.html')} active="writing">
  <section class="shell pt-[calc(var(--header-h)+48px)] pb-8 sm:pt-[calc(var(--header-h)+72px)] sm:pb-10">
    <h1 class="max-w-4xl text-[clamp(2.5rem,1.6rem+3.8vw,4.9rem)] font-medium leading-[1.02] tracking-[-0.036em] text-ink">
      <SplitText text="Everything I've written down." />
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-mist sm:text-lg" data-reveal style="--i:2">
      {posts.length} published notes, writeups, prototypes, and logs across 4 constellations.
    </p>
  </section>

  <section class="shell grid gap-4 pb-14 sm:grid-cols-2" aria-label="Categories">
    {
      CATEGORY_ORDER.map((k, i) => {
        const c = CATEGORIES[k];
        return (
          <a
            href={c.href}
            data-reveal
            style={`--i:${i}`}
            class="glass glass-lift group relative flex min-h-[192px] flex-col justify-between overflow-hidden rounded-[26px] p-6"
          >
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -right-14 -top-14 size-56 rounded-full opacity-35 blur-3xl transition-all duration-700 group-hover:scale-125 group-hover:opacity-60"
              style={`background: radial-gradient(circle, ${c.color}, transparent 65%)`}
            />
            <span class="relative flex items-center justify-between font-mono text-xs">
              <span class="flex items-center gap-2 uppercase tracking-[0.09em]" style={`color:${c.color}`}>
                <span class="dot" />
                {c.label}
              </span>
              <span class="rounded-full border border-line bg-void/55 px-2.5 py-0.5 text-mist">
                {counts[k]} {counts[k] === 1 ? 'entry' : 'entries'}
              </span>
            </span>
            <span class="relative mt-6 flex flex-col gap-2">
              <span class="text-3xl font-medium tracking-[-0.03em] text-ink sm:text-[2.5rem] sm:leading-[1.05]">{c.plural}</span>
              <span class="max-w-md text-[15px] leading-relaxed text-mist">{c.blurb}</span>
            </span>
          </a>
        );
      })
    }
  </section>

  <section class="shell pb-24" aria-labelledby="all-title">
    <div class="flex items-baseline justify-between gap-4 pb-4">
      <h2 id="all-title" class="text-xl font-medium tracking-[-0.02em] text-ink">All entries</h2>
      <span class="font-mono text-xs uppercase tracking-[0.08em] text-dim">Newest first</span>
    </div>
    <div class="border-t border-line">
      {posts.map((post, i) => <PostRow post={post} index={i} showSummary={false} />)}
    </div>
  </section>
</Base>

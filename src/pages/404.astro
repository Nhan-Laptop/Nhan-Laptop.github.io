---
import Base from '../layouts/Base.astro';
---

<Base title="Lost in space" description="This page drifted out of the galaxy." path="/404.html">
  <section class="shell grid min-h-[80svh] place-items-center pt-[var(--header-h)] text-center">
    <div class="flex flex-col items-center gap-6">
      <p class="eyebrow">Error 404 · signal lost</p>
      <h1 class="text-[clamp(4rem,3rem+8vw,10rem)] font-medium leading-none tracking-[-0.06em]">
        Lost in <span class="accent text-star">space.</span>
      </h1>
      <p class="max-w-md text-lg text-mist">That page drifted out of the galaxy — or never existed. Try search, or head back to the core.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">Back home</a>
        <button type="button" class="btn btn-ghost" data-cmdk-open>Search posts</button>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import SplitText from '../components/SplitText.astro';
import { countByCategory, getSummaries } from '../lib/posts';
import { url, CATEGORIES, SITE, formatDate, hash } from '../lib/site';

const posts = await getSummaries();
const counts = countByCategory(posts);
// Latest, but a multi-part series counts once (its first part stands in for the rest).
const latest = posts
  .filter((p) => !/-part-(?!1$)\d+$/i.test(p.id))
  .slice(0, 6);
const writeups = posts.filter((p) => p.category === 'writeup');
const learning = posts.filter((p) => p.category === 'learning');
const malware = learning.filter((p) => /malware-for-beginner-part-/i.test(p.id)).sort((a, b) => a.id.localeCompare(b.id));
const crypto = learning.filter((p) => p.topic !== 'malware-binary').slice(0, 7);
const life = posts.filter((p) => p.category === 'life');
const byId = (id: string) => posts.find((p) => p.id === id);
const pi = byId('projects/project-pi-ctf-solver');
const rag = posts.find((p) => p.id.startsWith('projects/project-Verifier-Guided'));

const chapters = [
  { id: 'top', label: 'Hello' },
  { id: 'latest', label: 'Latest' },
  { id: 'building', label: 'Building' },
  { id: 'writeups', label: 'Writeups' },
  { id: 'learning', label: 'Learning' },
  { id: 'now', label: 'Now' },
];
---

<Base starfield={false} bodyClass="home" description={SITE.description} path={url('/')}>
  <link slot="head" rel="preload" as="image" href={url('/galaxy-poster.webp')} fetchpriority="high" />

  <!-- Z-0 Far Field: fixed WebGL galaxy stage with smooth directional atmospheric scrims -->
  <div class="fixed inset-0 -z-10 bg-void" aria-hidden="true">
    <img
      src={url('/galaxy-poster.webp')}
      alt=""
      width="1920"
      height="1080"
      data-poster
      class="absolute inset-0 size-full object-cover transition-opacity duration-[1600ms] [object-position:70%_50%] max-[819px]:[object-position:72%_50%]"
    />
    <canvas data-galaxy class="absolute inset-0 size-full opacity-0 transition-opacity duration-[1600ms] cursor-grab"></canvas>
    <!-- Desktop directional atmospheric depth veil: keeps left reading lane velvet dark while right spiral shines -->
    <div
      class="pointer-events-none absolute inset-0 hidden md:block"
      style="background: linear-gradient(92deg, rgb(2 3 9 / 0.78) 0%, rgb(2 3 9 / 0.44) 38%, rgb(2 3 9 / 0.1) 66%, transparent 88%), linear-gradient(180deg, rgb(2 3 9 / 0.84) 0%, transparent 18%, transparent 76%, rgb(2 3 9 / 0.9) 100%);"
    ></div>
    <!-- Mobile full-height protective veil so copy and metrics stay razor sharp over the galactic core -->
    <div
      class="pointer-events-none absolute inset-0 md:hidden"
      style="background: linear-gradient(180deg, rgb(2 3 9 / 0.88) 0%, rgb(2 3 9 / 0.66) 46%, rgb(2 3 9 / 0.82) 100%);"
    ></div>
  </div>

  <!-- Z-2 Midground Chrome: collision-free frosted telemetry pills -->
  <div class="pointer-events-none fixed bottom-5 left-0 right-0 z-30 hidden sm:block" aria-hidden="true">
    <div class="shell flex items-end justify-between font-mono text-[11px] uppercase tracking-[0.1em]">
      <div class="hud-pill flex items-center gap-3 rounded-full px-4 py-2 text-mist">
        <span><span data-hud-chapter class="text-ink">01</span> / 0{chapters.length} · <span data-hud-label class="text-ink">Hello</span></span>
        <span class="h-3 w-px bg-line-strong"></span>
        <span><span data-hud-distance class="text-star tabular-nums">—</span> ly</span>
      </div>
      <span data-hud-hint class="hud-pill rounded-full px-3.5 py-2 text-mist transition-opacity duration-700">Drag to orbit · scroll to fly</span>
    </div>
  </div>

  <nav aria-label="Chapters" class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col gap-2.5 lg:flex">
    {
      chapters.map((c, i) => (
        <a
          href={`#${c.id}`}
          data-rail={i}
          class="group flex items-center justify-end gap-3 py-1"
          aria-label={c.label}
        >
          <span class="hud-pill rounded-full px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-[0.1em] text-ink opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            {c.label}
          </span>
          <span class="block h-[2px] w-4 rounded-full bg-mist/45 transition-all duration-500 group-hover:bg-ink group-data-[active]:w-8 group-data-[active]:bg-star group-data-[active]:shadow-[0_0_12px_rgb(255_208_147/0.75)]" />
        </a>
      ))
    }
  </nav>

  <!-- 00 · Hero -->
  <section id="top" data-chapter class="pointer-events-none relative z-10 flex min-h-[100svh] items-center">
    <div class="shell pb-20 pt-[calc(var(--header-h)+44px)] sm:pb-32 sm:pt-[calc(var(--header-h)+64px)]">
      <div class="pointer-events-auto flex max-w-[680px] flex-col gap-6 sm:gap-7">
        <a
          href={pi?.href ?? url('/categories/project.html')}
          class="hud-pill flex w-fit items-center gap-2.5 rounded-full py-2 pl-3.5 pr-4 font-mono text-xs text-ink transition-colors hover:border-line-strong"
          data-reveal
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-aurora opacity-65"></span>
            <span class="relative inline-flex size-2 rounded-full bg-aurora"></span>
          </span>
          currently building pi-ctf-solver
        </a>
        <h1 class="text-[clamp(2.65rem,1.4rem+4.2vw,5.15rem)] font-medium leading-[1.03] tracking-[-0.036em] text-balance">
          <SplitText text="Hi, I'm Nhan." class="block text-ink" />
          <span class="mt-1 block text-mist">
            <SplitText text="I break ciphers and build" offset={3} />
            <span class="split-word" style="--w:8"><span class="accent text-star">little universes</span></span>{' '}
            <SplitText text="of tools." offset={9} />
          </span>
        </h1>
        <p class="max-w-[33rem] text-lg leading-relaxed text-mist sm:text-[19px]" data-reveal style="--i:4">
          Information Security student at UIT – VNUHCM. I write long notes on lattice crypto, CTF challenges and malware internals — and ship small tools for CTF players.
        </p>
        <div class="flex flex-wrap gap-3 pt-1" data-reveal style="--i:5">
          <a class="btn btn-primary" href="#latest">Read my notes</a>
          <a class="btn btn-ghost" href={url('/universe.html')}>
            Explore the universe
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"></circle><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-20 12 12)"></ellipse></svg>
          </a>
        </div>
      </div>

      <!-- High-contrast Obsidian Instrument Dock: crisp over any starfield or galactic core -->
      <dl class="pointer-events-auto glass-dock mt-12 grid max-w-3xl grid-cols-2 overflow-hidden rounded-3xl sm:mt-16 sm:grid-cols-4" data-reveal style="--i:6">
        <div class="flex flex-col-reverse gap-1.5 border-b border-r border-line p-5 sm:border-b-0">
          <dt class="flex items-center gap-2 font-mono text-xs text-mist">
            <span class="dot size-1.5" style="color:#f4f6fc"></span>
            notes &amp; logs
          </dt>
          <dd class="text-3xl font-medium tracking-[-0.03em] text-ink sm:text-4xl">{posts.length}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1.5 border-b border-line p-5 sm:border-b-0 sm:border-r">
          <dt class="flex items-center gap-2 font-mono text-xs text-mist">
            <span class="dot size-1.5" style={`color:${CATEGORIES.writeup.color}`}></span>
            CTF writeups
          </dt>
          <dd class="text-3xl font-medium tracking-[-0.03em] text-ink sm:text-4xl">{counts.writeup}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1.5 border-r border-line p-5">
          <dt class="flex items-center gap-2 font-mono text-xs text-mist">
            <span class="dot size-1.5" style={`color:${CATEGORIES.project.color}`}></span>
            projects
          </dt>
          <dd class="text-3xl font-medium tracking-[-0.03em] text-ink sm:text-4xl">{counts.project}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1.5 p-5">
          <dt class="flex items-center gap-2 font-mono text-xs text-mist">
            <span class="dot size-1.5" style={`color:${CATEGORIES.learning.color}`}></span>
            malware series
          </dt>
          <dd class="text-3xl font-medium tracking-[-0.03em] text-ink sm:text-4xl">{malware.length}/5</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 01 · Latest -->
  <section id="latest" data-chapter class="pointer-events-none relative z-10 flex min-h-[115svh] items-center py-24 pb-32" aria-labelledby="latest-title">
    <div class="shell flex justify-end">
      <div class="pointer-events-auto glass w-full max-w-[660px] rounded-[30px] p-6 sm:p-9">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="latest-title" class="text-[clamp(2rem,1.4rem+2.2vw,3.25rem)] font-medium leading-[1.04] tracking-[-0.035em] text-ink">
            <SplitText text="Latest notes" />
          </h2>
          <span class="font-mono text-xs uppercase tracking-[0.09em] text-dim">Fresh from the notebook</span>
        </div>
        <ul class="mt-7 flex flex-col">
          {
            latest.map((p, i) => (
              <li class="post-row border-t border-line py-4" data-reveal style={`--i:${i}`}>
                <a href={p.href} class="flex items-start gap-4">
                  <span class="dot mt-2.5" style={`color:${CATEGORIES[p.category].color}`} />
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="text-[17px] font-medium leading-snug tracking-[-0.015em] text-ink sm:text-lg" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
                    <span class="font-mono text-xs text-dim">
                      <span style={`color:${CATEGORIES[p.category].color}`}>{CATEGORIES[p.category].label}</span> · {formatDate(p.date)} · {p.minutes} min
                    </span>
                  </span>
                  <svg class="arrow mt-2 shrink-0 text-mist" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={url('/categories/index.html')} class="btn btn-ghost mt-6">All {posts.length} entries →</a>
      </div>
    </div>
  </section>

  <!-- 02 · Building -->
  <section id="building" data-chapter class="pointer-events-none relative z-10 flex min-h-[115svh] items-center py-24 pb-36" aria-labelledby="building-title">
    <div class="shell">
      <div class="pointer-events-auto max-w-[820px]">
        <h2 id="building-title" class="text-[clamp(2.25rem,1.5rem+2.8vw,4.1rem)] font-medium leading-[1.03] tracking-[-0.036em] text-ink">
          <SplitText text="Tools that solve" />{' '}
          <span class="split-word" style="--w:3"><span class="accent text-aurora">the boring part.</span></span>
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-mist sm:text-lg" data-reveal style="--i:1">
          Security automation and verifier-guided multi-agent prototypes built for real CTF workflows.
        </p>

        <div class="mt-9 grid gap-5">
          {
            pi && (
              <a href={pi.href} class="glass glass-lift group grid overflow-hidden rounded-[28px] sm:grid-cols-[1.05fr_1fr]" data-reveal>
                <div class="flex flex-col gap-4 p-6 sm:p-8">
                  <span class="flex items-center justify-between">
                    <span class="size-10 rounded-full bg-[radial-gradient(circle_at_30%_30%,#e2fff2,#88f2c8_42%,#194c39)] shadow-[0_8px_24px_rgb(136_242_200/0.28)]" />
                    <span class="rounded-full border border-aurora/35 bg-aurora/12 px-3 py-1 font-mono text-xs text-aurora">active</span>
                  </span>
                  <span class="text-2xl font-medium tracking-[-0.025em] text-ink" style={`view-transition-name: t-${hash(pi.id)}`}>pi-ctf-solver</span>
                  <span class="text-[15px] leading-relaxed text-mist">{pi.summary}</span>
                  <span class="mt-auto pt-2 font-mono text-xs text-dim">pi package · agents · {formatDate(pi.date)}</span>
                </div>
                <div class="flex items-center p-3 sm:p-4 sm:pl-0">
                  <div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl border border-line-strong bg-deep shadow-[0_14px_36px_-10px_rgb(0_0_0/0.75)] sm:h-full sm:aspect-auto sm:min-h-52">
                    <img
                      src={url('/assets/pi-ctf/dashboard.webp')}
                      alt="pi-ctf-solver live dashboard"
                      loading="lazy"
                      class="absolute inset-0 size-full object-cover object-left-top transition-transform duration-[1100ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
                    />
                  </div>
                </div>
              </a>
            )
          }
          {
            rag && (
              <a href={rag.href} class="glass glass-lift group grid gap-5 rounded-[28px] p-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end sm:p-8" data-reveal style="--i:1">
                <div class="flex flex-col gap-3.5">
                  <span class="flex items-center gap-3">
                    <span class="size-9 rounded-full bg-[radial-gradient(circle_at_30%_30%,#eef0ff,#b0c0ff_42%,#2a2460)] shadow-[0_8px_24px_rgb(176_192_255/0.28)]" />
                    <span class="rounded-full border border-nebula/35 bg-nebula/12 px-3 py-1 font-mono text-xs text-nebula">research prototype</span>
                  </span>
                  <span class="text-2xl font-medium leading-snug tracking-[-0.025em] text-ink" style={`view-transition-name: t-${hash(rag.id)}`}>{rag.title}</span>
                  <span class="max-w-2xl text-[15px] leading-relaxed text-mist">{rag.summary}</span>
                  <span class="font-mono text-xs text-dim">{formatDate(rag.date)} · {rag.minutes} min read</span>
                </div>
                <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.08em] text-nebula transition-transform duration-300 group-hover:translate-x-1">
                  Read paper note →
                </span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · Writeups: centered over the galactic disk with crisp obsidian cards -->
  <section id="writeups" data-chapter class="pointer-events-none relative z-10 flex min-h-[110svh] flex-col justify-center py-24 pb-36" aria-labelledby="writeups-title">
    <div class="shell pointer-events-auto">
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="writeups-title" class="text-[clamp(2.4rem,1.5rem+3.4vw,4.6rem)] font-medium leading-[1.02] tracking-[-0.036em] text-ink">
          <SplitText text="Challenges, solved" />{' '}
          <span class="split-word" style="--w:2"><span class="accent text-star">step by step.</span></span>
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-mist sm:text-lg" data-reveal style="--i:1">
          {counts.writeup} reproducible CTF writeups spanning lattice attacks, PRNG state recovery, and homomorphic encryption.
        </p>
      </div>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          writeups.map((p, i) => (
            <li data-reveal style={`--i:${Math.min(i, 7)}`}>
              <a href={p.href} class="glass glass-lift group flex h-full flex-col justify-between gap-4 rounded-3xl p-5 hover:border-star/45">
                <div class="flex flex-col gap-2.5">
                  <span class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.08em] text-dim">
                    <span>{formatDate(p.date)}</span>
                    <span class="text-star/90">{p.minutes} min</span>
                  </span>
                  <span class="text-lg font-medium leading-snug tracking-[-0.018em] text-ink" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
                  {p.summary && <span class="line-clamp-2 text-sm leading-relaxed text-mist">{p.summary}</span>}
                </div>
                {
                  p.tags.length > 0 && (
                    <span class="flex flex-wrap gap-x-2.5 gap-y-1 border-t border-line pt-3 font-mono text-[11px] text-dim">
                      {p.tags.slice(0, 3).map((t) => <span>#{t}</span>)}
                    </span>
                  )
                }
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 04 · Learning: the dense core -->
  <section id="learning" data-chapter class="pointer-events-none relative z-10 flex min-h-[115svh] items-center py-24 pb-36" aria-labelledby="learning-title">
    <div class="shell flex justify-end">
      <div class="pointer-events-auto w-full max-w-[680px]">
        <h2 id="learning-title" class="text-[clamp(2.25rem,1.5rem+2.8vw,4.1rem)] font-medium leading-[1.03] tracking-[-0.036em] text-ink">
          <SplitText text="Where the" />{' '}
          <span class="split-word" style="--w:2"><span class="accent text-nebula">math lives.</span></span>
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-mist sm:text-lg" data-reveal style="--i:1">
          {counts.learning} long-form study notes on lattices, homomorphic encryption, protocols, and Windows internals.
        </p>

        {
          malware.length > 0 && (
            <div class="glass mt-9 rounded-[28px] p-6 sm:p-7" data-reveal>
              <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-dim">
                <span class="text-nebula">SERIES · {malware.length} PARTS</span>
                <span>windows · pe · shellcode</span>
              </div>
              <a href={malware[0].href} class="link-underline mt-3 inline-block text-2xl font-medium tracking-[-0.025em] text-ink">
                Malware for Beginners
              </a>
              <ol class="mt-5 grid gap-2 sm:grid-cols-5">
                {malware.map((m, i) => (
                  <li>
                    <a
                      href={m.href}
                      class="group flex h-full flex-col gap-1.5 rounded-2xl border border-line bg-void/45 p-3 text-sm text-mist transition-colors hover:border-nebula/45 hover:bg-nebula/10 hover:text-ink"
                    >
                      <span class="font-mono text-[11px] text-nebula">0{i + 1}</span>
                      <span class="line-clamp-3 leading-snug">{m.title.replace(/^.*?:\s*/, '')}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        <ul class="glass mt-4 flex flex-col rounded-[28px] px-6 py-2 sm:px-7">
          {
            crypto.map((p, i) => (
              <li class="post-row border-b border-line last:border-b-0" data-reveal style={`--i:${i}`}>
                <a href={p.href} class="flex items-baseline justify-between gap-4 py-4">
                  <span class="font-medium leading-snug text-ink" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
                  <span class="shrink-0 font-mono text-xs text-dim">{p.tags[0] ? `#${p.tags[0]}` : `${p.minutes} min`}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={url('/categories/learning.html')} class="btn btn-ghost mt-6">All learning notes →</a>
      </div>
    </div>
  </section>

  <!-- 05 · Now / contact: pulled back to see the whole galaxy -->
  <section id="now" data-chapter class="pointer-events-none relative z-10 flex min-h-[105svh] items-end pb-32 pt-24" aria-labelledby="now-title">
    <div class="shell pointer-events-auto">
      <h2 id="now-title" class="max-w-4xl text-[clamp(2.4rem,1.5rem+3.4vw,4.8rem)] font-medium leading-[1.02] tracking-[-0.036em] text-ink">
        <SplitText text="That's the whole galaxy —" />{' '}
        <span class="split-word" style="--w:5"><span class="accent text-star">so far.</span></span>
      </h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="glass flex flex-col gap-5 rounded-[28px] p-7 sm:p-8" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-star">/now</p>
          <ul class="flex flex-col gap-3.5 text-[17px] leading-snug text-ink">
            <li><span class="text-mist">Building — </span>pi-ctf-solver, CTF automation as a Pi package</li>
            <li><span class="text-mist">Studying — </span>lattices: MP-LWE, PKEET, IBE/HIBE</li>
            <li><span class="text-mist">Just shipped — </span>Malware for Beginners, all {malware.length} parts</li>
            {life[0] && <li><span class="text-mist">Life — </span><a class="link-underline text-star" href={life[0].href}>{life[0].title}</a></li>}
          </ul>
        </div>
        <div
          class="flex flex-col justify-between gap-8 rounded-[28px] border border-line-strong p-7 shadow-[inset_0_1px_0_rgb(255_255_255/0.14),0_28px_70px_-20px_rgb(0_0_0/0.82)] backdrop-blur-2xl sm:p-8"
          style="--i:1; background: radial-gradient(115% 115% at 100% 0%, rgb(82 68 168 / 0.58), rgb(10 13 26 / 0.92) 62%);"
          data-reveal
        >
          <p class="text-[26px] font-medium leading-tight tracking-[-0.025em] text-ink sm:text-[28px]">Say hi, or follow along as new notes land.</p>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-primary" href={SITE.github} rel="noopener">GitHub ↗</a>
            <a class="btn btn-ghost" href={url('/rss.xml')}>RSS feed</a>
            <a class="btn btn-ghost" href={url('/universe.html')}>Universe map</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home';
  </script>
</Base>

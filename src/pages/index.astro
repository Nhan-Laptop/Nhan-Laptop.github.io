---
import Base from '../layouts/Base.astro';
import SplitText from '../components/SplitText.astro';
import { countByCategory, getSummaries } from '../lib/posts';
import { CATEGORIES, SITE, formatDate, hash } from '../lib/site';

const posts = await getSummaries();
const counts = countByCategory(posts);
// Latest, but a multi-part series counts once (its first part stands in for the rest).
const latest = posts
  .filter((p) => !/-part-(?!1$)\d+$/i.test(p.id))
  .slice(0, 6);
const writeups = posts.filter((p) => p.category === 'writeup');
const learning = posts.filter((p) => p.category === 'learning');
const malware = learning.filter((p) => /malware-for-beginner-part-/i.test(p.id)).sort((a, b) => a.id.localeCompare(b.id));
const crypto = learning.filter((p) => p.topic !== 'malware-binary').slice(0, 7);
const life = posts.filter((p) => p.category === 'life');
const byId = (id: string) => posts.find((p) => p.id === id);
const pi = byId('projects/project-pi-ctf-solver');
const rag = posts.find((p) => p.id.startsWith('projects/project-Verifier-Guided'));

const chapters = [
  { id: 'top', label: 'Hello' },
  { id: 'latest', label: 'Latest' },
  { id: 'building', label: 'Building' },
  { id: 'writeups', label: 'Writeups' },
  { id: 'learning', label: 'Learning' },
  { id: 'now', label: 'Now' },
];
---

<Base starfield={false} bodyClass="home" description={SITE.description} path="/">
  <link slot="head" rel="preload" as="image" href="/galaxy-poster.webp" fetchpriority="high" />

  <!-- The galaxy: a fixed WebGL stage behind every chapter. -->
  <div class="fixed inset-0 -z-10 bg-void" aria-hidden="true">
    <img
      src="/galaxy-poster.webp"
      alt=""
      width="1920"
      height="1080"
      data-poster
      class="absolute inset-0 size-full object-cover transition-opacity duration-[1600ms] [object-position:70%_50%] max-[819px]:[object-position:72%_50%]"
    />
    <canvas data-galaxy class="absolute inset-0 size-full opacity-0 transition-opacity duration-[1600ms] cursor-grab"></canvas>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_90%_at_70%_50%,transparent_40%,rgb(2_3_9/0.65)_100%)]"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-void/80 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[70%] bg-gradient-to-b from-void/75 via-void/40 to-transparent md:hidden"></div>
  </div>

  <!-- HUD -->
  <div class="pointer-events-none fixed bottom-5 left-0 right-0 z-0 hidden sm:block" aria-hidden="true">
    <div class="shell flex items-end justify-between font-mono text-[11px] uppercase tracking-[0.1em] text-dim">
      <div class="flex flex-col gap-1">
        <span><span data-hud-chapter class="text-mist">01</span> / 0{chapters.length} — <span data-hud-label>Hello</span></span>
        <span><span data-hud-distance class="text-star">—</span> ly from the core</span>
      </div>
      <span data-hud-hint class="transition-opacity duration-700">Drag to orbit · scroll to fly</span>
    </div>
  </div>
  <nav aria-label="Chapters" class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col gap-3 lg:flex">
    {
      chapters.map((c, i) => (
        <a
          href={`#${c.id}`}
          data-rail={i}
          class="group flex items-center justify-end gap-3 py-1"
          aria-label={c.label}
        >
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-dim opacity-0 transition-opacity group-hover:opacity-100">{c.label}</span>
          <span class="block h-px w-4 bg-dim transition-all duration-500 group-data-[active]:w-8 group-data-[active]:bg-star" />
        </a>
      ))
    }
  </nav>

  <!-- 00 · Hero -->
  <section id="top" data-chapter class="pointer-events-none relative z-10 flex min-h-[108svh] items-center">
    <div class="shell pb-[8svh] pt-[calc(var(--header-h)+56px)]">
      <div class="pointer-events-auto flex max-w-[720px] flex-col gap-7">
        <a
          href={pi?.href ?? '/categories/project.html'}
          class="flex w-fit items-center gap-2.5 rounded-full border border-line bg-void/50 py-2 pl-3 pr-4 font-mono text-xs text-mist backdrop-blur-md transition-colors hover:border-line-strong hover:text-ink"
          data-reveal
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-aurora opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-aurora"></span>
          </span>
          currently building pi-ctf-solver
        </a>
        <h1 class="text-[clamp(2.9rem,1.5rem+4.6vw,5.4rem)] font-medium leading-[0.98] tracking-[-0.055em]">
          <SplitText text="Hi, I'm Nhan." class="block" />
          <span class="block text-mist">
            <SplitText text="I break ciphers and build" offset={3} />
            <span class="split-word" style="--w:8"><span class="accent text-star">little universes</span></span>{' '}
            <SplitText text="of tools." offset={9} />
          </span>
        </h1>
        <p class="max-w-[30rem] text-lg leading-relaxed text-mist" data-reveal style="--i:4">
          Information Security student at UIT – VNUHCM. I write long notes on lattice crypto, CTF challenges and malware internals — and ship small tools for CTF players.
        </p>
        <div class="flex flex-wrap gap-3" data-reveal style="--i:5">
          <a class="btn btn-primary" href="#latest">Read my notes</a>
          <a class="btn btn-ghost bg-void/30 backdrop-blur-md" href="/universe.html">
            Explore the universe
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"></circle><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-20 12 12)"></ellipse></svg>
          </a>
        </div>
      </div>

      <dl class="pointer-events-auto mt-20 grid max-w-3xl grid-cols-2 overflow-hidden rounded-3xl border border-line bg-void/40 backdrop-blur-md sm:grid-cols-4" data-reveal style="--i:6">
        <div class="border-b border-r border-line p-5 sm:border-b-0 flex flex-col-reverse gap-1">
          <dt class="text-sm text-dim">notes &amp; logs</dt>
          <dd class="text-4xl font-medium tracking-[-0.04em]">{posts.length}</dd>
        </div>
        <div class="border-b border-line p-5 sm:border-b-0 sm:border-r flex flex-col-reverse gap-1">
          <dt class="text-sm text-dim">CTF writeups</dt>
          <dd class="text-4xl font-medium tracking-[-0.04em]">{counts.writeup}</dd>
        </div>
        <div class="border-r border-line p-5 flex flex-col-reverse gap-1">
          <dt class="text-sm text-dim">projects</dt>
          <dd class="text-4xl font-medium tracking-[-0.04em]">{counts.project}</dd>
        </div>
        <div class="p-5 flex flex-col-reverse gap-1">
          <dt class="text-sm text-dim">malware series</dt>
          <dd class="text-4xl font-medium tracking-[-0.04em]">{malware.length}/5</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 01 · Latest -->
  <section id="latest" data-chapter class="pointer-events-none relative z-10 flex min-h-[130svh] items-center py-24" aria-labelledby="latest-title">
    <div class="shell flex justify-end">
      <div class="pointer-events-auto glass w-full max-w-[640px] rounded-[32px] p-6 sm:p-9">
        <p class="eyebrow" data-reveal>01 · Fresh from the notebook</p>
        <h2 id="latest-title" class="mt-4 text-[clamp(2.2rem,1.6rem+2.4vw,3.6rem)] font-medium leading-none tracking-[-0.045em]">
          <SplitText text="Latest notes" />
        </h2>
        <ul class="mt-8 flex flex-col">
          {
            latest.map((p, i) => (
              <li class="post-row border-t border-line py-4" data-reveal style={`--i:${i}`}>
                <a href={p.href} class="flex items-start gap-4">
                  <span class="dot mt-2.5" style={`color:${CATEGORIES[p.category].color}`} />
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="text-lg font-medium leading-snug tracking-[-0.015em]" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
                    <span class="font-mono text-xs text-dim">
                      {CATEGORIES[p.category].label} · {formatDate(p.date)} · {p.minutes} min
                    </span>
                  </span>
                  <svg class="arrow mt-2 text-dim" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/categories/index.html" class="btn btn-ghost mt-6">All {posts.length} entries →</a>
      </div>
    </div>
  </section>

  <!-- 02 · Building -->
  <section id="building" data-chapter class="pointer-events-none relative z-10 flex min-h-[130svh] items-center py-24" aria-labelledby="building-title">
    <div class="shell">
      <div class="pointer-events-auto max-w-[680px]">
        <p class="eyebrow" data-reveal>02 · Things I'm building</p>
        <h2 id="building-title" class="mt-4 text-[clamp(2.4rem,1.6rem+3vw,4.4rem)] font-medium leading-[0.98] tracking-[-0.05em]">
          <SplitText text="Tools that solve" />
          <span class="split-word" style="--w:3"><span class="accent text-aurora">the boring part.</span></span>
        </h2>
        <div class="mt-10 grid gap-4">
          {
            pi && (
              <a href={pi.href} class="glass group grid overflow-hidden rounded-[28px] transition-colors hover:border-line-strong sm:grid-cols-[1.1fr_1fr]" data-reveal>
                <div class="flex flex-col gap-4 p-6 sm:p-7">
                  <span class="flex items-center justify-between">
                    <span class="size-11 rounded-full bg-[radial-gradient(circle_at_30%_30%,#d8ffec,#8ef0c4_40%,#1d5c44)] shadow-[0_0_40px_rgb(142_240_196/0.35)]" />
                    <span class="rounded-full bg-aurora/10 px-3 py-1 font-mono text-xs text-aurora">active</span>
                  </span>
                  <span class="text-2xl font-medium tracking-[-0.03em]" style={`view-transition-name: t-${hash(pi.id)}`}>pi-ctf-solver</span>
                  <span class="text-[15px] leading-relaxed text-mist">{pi.summary}</span>
                  <span class="mt-auto font-mono text-xs text-dim">pi package · agents · {formatDate(pi.date)}</span>
                </div>
                <div class="relative min-h-48 overflow-hidden border-t border-line sm:border-l sm:border-t-0">
                  <img src="/assets/pi-ctf/dashboard.webp" alt="pi-ctf-solver live dashboard" loading="lazy" class="absolute inset-0 size-full object-cover object-left-top transition-transform duration-[1200ms] ease-[var(--ease-out-expo)] group-hover:scale-105" />
                </div>
              </a>
            )
          }
          {
            rag && (
              <a href={rag.href} class="glass group flex flex-col gap-4 rounded-[28px] p-6 transition-colors hover:border-line-strong sm:p-7" data-reveal style="--i:1">
                <span class="flex items-center justify-between">
                  <span class="size-11 rounded-full bg-[radial-gradient(circle_at_30%_30%,#e6e1ff,#a9b8ff_40%,#2e2566)] shadow-[0_0_40px_rgb(169_184_255/0.35)]" />
                  <span class="rounded-full bg-nebula/10 px-3 py-1 font-mono text-xs text-nebula">research</span>
                </span>
                <span class="text-2xl font-medium tracking-[-0.03em]" style={`view-transition-name: t-${hash(rag.id)}`}>{rag.title}</span>
                <span class="text-[15px] leading-relaxed text-mist">{rag.summary}</span>
                <span class="font-mono text-xs text-dim">research prototype · {formatDate(rag.date)}</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · Writeups: inside the disk, looking along the band. -->
  <section id="writeups" data-chapter class="pointer-events-none relative z-10 flex min-h-[140svh] flex-col justify-between py-[18svh]" aria-labelledby="writeups-title">
    <div class="shell pointer-events-auto text-center">
      <p class="eyebrow" data-reveal>03 · {counts.writeup} CTF writeups · from inside the disk</p>
      <h2 id="writeups-title" class="mx-auto mt-4 max-w-4xl text-[clamp(2.6rem,1.6rem+4vw,5.6rem)] font-medium leading-[0.95] tracking-[-0.055em]">
        <SplitText text="Challenges, solved" />
        <span class="split-word" style="--w:2"><span class="accent text-star">step by step.</span></span>
      </h2>
    </div>
    <div class="shell pointer-events-auto mt-[38svh]">
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          writeups.map((p, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href={p.href} class="glass group flex h-full flex-col justify-between gap-6 rounded-3xl p-5 transition-colors hover:border-star/40">
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-dim">{formatDate(p.date)}</span>
                <span class="text-lg font-medium leading-snug tracking-[-0.02em]" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 04 · Learning: the bulge -->
  <section id="learning" data-chapter class="pointer-events-none relative z-10 flex min-h-[140svh] items-center py-24" aria-labelledby="learning-title">
    <div class="shell flex justify-end">
      <div class="pointer-events-auto w-full max-w-[640px]">
        <p class="eyebrow" data-reveal>04 · {counts.learning} learning notes · the dense core</p>
        <h2 id="learning-title" class="mt-4 text-[clamp(2.4rem,1.6rem+3vw,4.4rem)] font-medium leading-[0.98] tracking-[-0.05em]">
          <SplitText text="Where the" />
          <span class="split-word" style="--w:2"><span class="accent text-nebula">math lives.</span></span>
        </h2>
        {
          malware.length > 0 && (
            <a href={malware[0].href} class="glass mt-10 block rounded-[28px] p-6 transition-colors hover:border-line-strong sm:p-7" data-reveal>
              <span class="flex items-center justify-between font-mono text-xs text-dim">
                <span>SERIES · {malware.length} PARTS</span>
                <span>windows · pe · shellcode</span>
              </span>
              <span class="mt-4 block text-2xl font-medium tracking-[-0.03em]">Malware for Beginners</span>
              <ol class="mt-5 grid gap-2 text-sm text-mist sm:grid-cols-5">
                {malware.map((m, i) => (
                  <li class="border-t border-line pt-2">
                    <span class="font-mono text-[11px] text-nebula">0{i + 1}</span>
                    <span class="mt-1 block leading-snug">{m.title.replace(/^.*?:\s*/, '')}</span>
                  </li>
                ))}
              </ol>
            </a>
          )
        }
        <ul class="glass mt-4 flex flex-col rounded-[28px] px-6 py-2 sm:px-7">
          {
            crypto.map((p, i) => (
              <li class="post-row border-b border-line last:border-b-0" data-reveal style={`--i:${i}`}>
                <a href={p.href} class="flex items-baseline justify-between gap-4 py-4">
                  <span class="font-medium leading-snug" style={`view-transition-name: t-${hash(p.id)}`}>{p.title}</span>
                  <span class="shrink-0 font-mono text-[11px] text-dim">{p.tags[0] ? `#${p.tags[0]}` : `${p.minutes} min`}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/categories/learning.html" class="btn btn-ghost mt-6 bg-void/30 backdrop-blur-md">All learning notes →</a>
      </div>
    </div>
  </section>

  <!-- 05 · Now / contact: pulled back to see the whole galaxy. -->
  <section id="now" data-chapter class="pointer-events-none relative z-10 flex min-h-[120svh] items-end pb-28 pt-24" aria-labelledby="now-title">
    <div class="shell pointer-events-auto">
      <p class="eyebrow" data-reveal>05 · 100,000 light years out</p>
      <h2 id="now-title" class="mt-4 max-w-4xl text-[clamp(2.6rem,1.6rem+4vw,5.6rem)] font-medium leading-[0.95] tracking-[-0.055em]">
        <SplitText text="That's the whole galaxy —" />
        <span class="split-word" style="--w:5"><span class="accent text-star">so far.</span></span>
      </h2>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        <div class="glass flex flex-col gap-5 rounded-[28px] p-7" data-reveal>
          <p class="font-mono text-xs text-star">/now</p>
          <ul class="flex flex-col gap-3.5 text-[17px] leading-snug">
            <li><span class="text-dim">Building — </span>pi-ctf-solver, CTF automation as a Pi package</li>
            <li><span class="text-dim">Studying — </span>lattices: MP-LWE, PKEET, IBE/HIBE</li>
            <li><span class="text-dim">Just shipped — </span>Malware for Beginners, all {malware.length} parts</li>
            {life[0] && <li><span class="text-dim">Life — </span><a class="link-underline" href={life[0].href}>{life[0].title}</a></li>}
          </ul>
        </div>
        <div class="flex flex-col justify-between gap-8 rounded-[28px] border border-line bg-[radial-gradient(120%_120%_at_100%_0%,rgb(69_54_140/0.55),rgb(7_9_18/0.8)_60%)] p-7 backdrop-blur-md" data-reveal style="--i:1">
          <p class="text-[28px] font-medium leading-tight tracking-[-0.03em]">Say hi, or follow along as new notes land.</p>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-primary" href={SITE.github} rel="noopener">GitHub ↗</a>
            <a class="btn btn-ghost" href="/rss.xml">RSS feed</a>
            <a class="btn btn-ghost" href="/universe.html">Universe map</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home';
  </script>
</Base>

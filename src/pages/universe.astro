---
import Base from '../layouts/Base.astro';
import { getSummaries } from '../lib/posts';
import { url, CATEGORIES, CATEGORY_ORDER, formatDate } from '../lib/site';

const posts = await getSummaries();
const data = posts.map((p) => ({ id: p.id, t: p.title, h: p.href, c: p.category, d: p.date, s: p.summary, g: p.tags, m: p.minutes }));
const colors = Object.fromEntries(CATEGORY_ORDER.map((k) => [k, CATEGORIES[k].color]));
---

<Base
  title="Universe"
  description="Every post as a star in a procedurally generated Milky Way — drag, zoom and click to read."
  path={url('/universe.html')}
  starfield={false}
  footer={false}
  active="universe"
  bodyClass="overflow-hidden"
>
  <div class="fixed inset-0 bg-void">
    <img src={url('/galaxy-poster.webp')} alt="" aria-hidden="true" class="absolute inset-0 size-full object-cover opacity-60" data-poster />
    <canvas data-galaxy class="absolute inset-0 size-full opacity-0 transition-opacity duration-[1400ms] cursor-grab" aria-hidden="true"></canvas>
    <div data-markers class="pointer-events-none absolute inset-0 overflow-hidden"></div>
  </div>

  <!-- Controls -->
  <div class="pointer-events-none fixed inset-x-0 top-[var(--header-h)] z-30">
    <div class="shell flex flex-wrap items-start justify-between gap-4 pt-4">
      <div class="pointer-events-auto flex flex-col gap-3">
        <h1 class="text-3xl font-medium tracking-[-0.04em] sm:text-4xl">The universe map</h1>
        <p class="max-w-sm text-sm leading-relaxed text-mist">{posts.length} posts, one star each. Each topic follows its own spiral arm, oldest nearest the core.</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Show topics">
          {
            CATEGORY_ORDER.map((k) => (
              <button type="button" class="chip chip-toggle backdrop-blur-md" data-filter={k} aria-pressed="true">
                <span class="dot size-1.5" style={`color:${CATEGORIES[k].color}`} />
                {CATEGORIES[k].plural}
              </button>
            ))
          }
        </div>
      </div>
      <button type="button" data-list-toggle aria-expanded="false" aria-controls="star-list" class="chip pointer-events-auto bg-void/50 backdrop-blur-md">List view</button>
    </div>
  </div>

  <div class="pointer-events-none fixed inset-x-0 bottom-0 z-30 pb-5">
    <div class="shell flex items-end justify-between gap-4">
      <p class="hidden font-mono text-[11px] uppercase tracking-[0.1em] text-dim sm:block">Drag to orbit · scroll to zoom · click a star</p>
      <div class="pointer-events-auto ml-auto flex gap-2">
        <button type="button" data-zoom="in" class="grid size-11 place-items-center rounded-full border border-line bg-void/60 backdrop-blur-md hover:border-line-strong" aria-label="Zoom in">+</button>
        <button type="button" data-zoom="out" class="grid size-11 place-items-center rounded-full border border-line bg-void/60 backdrop-blur-md hover:border-line-strong" aria-label="Zoom out">−</button>
        <button type="button" data-zoom="reset" class="rounded-full border border-line bg-void/60 px-4 text-sm backdrop-blur-md hover:border-line-strong" aria-label="Reset view">Reset</button>
      </div>
    </div>
  </div>

  <!-- Selected star -->
  <aside
    data-card
    hidden
    aria-live="polite"
    class="glass fixed bottom-20 left-4 right-4 z-40 rounded-[28px] p-6 sm:bottom-auto sm:left-auto sm:right-6 sm:top-1/2 sm:w-[380px] sm:-translate-y-1/2"
  >
    <button type="button" data-card-close class="absolute right-4 top-4 grid size-9 place-items-center rounded-full border border-line text-mist hover:text-ink" aria-label="Close">×</button>
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.08em]" data-card-cat></p>
    <h2 class="mt-3 pr-8 text-2xl font-medium leading-tight tracking-[-0.03em]" data-card-title></h2>
    <p class="mt-3 text-[15px] leading-relaxed text-mist" data-card-summary></p>
    <p class="mt-4 font-mono text-xs text-dim" data-card-meta></p>
    <a class="btn btn-primary mt-6" data-card-link href={url('/')}>Read →</a>
  </aside>

  <!-- Accessible list (also the no-JS view) -->
  <section id="star-list" data-list class="fixed inset-0 z-[45] overflow-y-auto bg-void/90 pt-[calc(var(--header-h)+24px)] backdrop-blur-xl [.js_&]:hidden" aria-label="All posts">
    <div class="shell pb-20">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-medium tracking-[-0.03em]">All stars</h2>
        <button type="button" data-list-close class="chip">Back to the map</button>
      </div>
      <ul class="mt-6 border-t border-line">
        {
          posts.map((p) => (
            <li class="border-b border-line">
              <a href={p.href} class="flex items-baseline gap-4 py-4 hover:text-star">
                <span class="dot" style={`color:${CATEGORIES[p.category].color}`} />
                <span class="flex-1">{p.title}</span>
                <span class="font-mono text-xs text-dim">{formatDate(p.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script type="application/json" data-stars set:html={JSON.stringify({ posts: data, colors })} />
  <script>
    import '../scripts/universe';
  </script>
</Base>

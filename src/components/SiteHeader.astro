---
interface Props {
  active?: string;
}
const { active } = Astro.props;
const links = [
  { key: 'writing', label: 'Writing', href: '/categories/index.html' },
  { key: 'projects', label: 'Projects', href: '/categories/project.html' },
  { key: 'universe', label: 'Universe', href: '/universe.html' },
  { key: 'tags', label: 'Tags', href: '/tags/index.html' },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500 data-[scrolled]:border-b data-[scrolled]:border-line data-[scrolled]:bg-void/70 data-[scrolled]:backdrop-blur-xl"
>
  <div class="shell flex h-[var(--header-h)] items-center justify-between gap-3">
    <a href="/" class="group flex items-center gap-3 rounded-full pr-2 text-[15px] font-medium" aria-label="Nhan — home">
      <span class="relative grid size-9 place-items-center overflow-hidden rounded-full ring-1 ring-line-strong">
        <img src="/self.webp" alt="" width="36" height="36" class="size-full object-cover" />
      </span>
      <span class="flex flex-col leading-tight">
        <span>nhan</span>
        <span class="font-mono text-[11px] text-dim transition-colors group-hover:text-mist">security log</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 rounded-full border border-line bg-void/40 p-1 backdrop-blur-md md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={active === l.key ? 'page' : undefined}
            class="rounded-full px-4 py-2.5 text-sm text-mist transition-colors hover:text-ink aria-[current=page]:bg-white/[0.08] aria-[current=page]:text-ink"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-cmdk-open
        class="flex min-h-11 items-center gap-3 rounded-full border border-line bg-void/40 pl-4 pr-2 text-sm text-mist backdrop-blur-md transition-colors hover:border-line-strong hover:text-ink"
        aria-label="Search posts"
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden rounded-full border border-line px-2 py-0.5 font-mono text-[11px] sm:inline">⌘K</kbd>
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 place-items-center rounded-full border border-line bg-void/40 backdrop-blur-md md:hidden"
        aria-label="Open menu"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8h16M4 16h16"></path></svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    hidden
    class="shell pb-6 md:hidden"
  >
    <div class="glass flex flex-col rounded-3xl p-2">
      <a href="/" class="rounded-2xl px-4 py-3.5 text-lg">Home</a>
      {links.map((l) => <a href={l.href} class="rounded-2xl px-4 py-3.5 text-lg" aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>)}
      <a href="https://github.com/Nhan-Laptop" class="rounded-2xl px-4 py-3.5 text-lg text-mist" rel="noopener">GitHub ↗</a>
    </div>
  </nav>
</header>

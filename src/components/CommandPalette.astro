---
import { SITE, url } from '../lib/site';

const routes = {
  home: url('/'),
  categories: url('/categories/index.html'),
  universe: url('/universe.html'),
  tags: url('/tags/index.html'),
  rss: url('/rss.xml'),
  github: SITE.github,
  email: 'nguyentrongnhan06cm@gmail.com',
};
---

<dialog
  data-cmdk
  data-index-url={url('/search-index.json')}
  data-routes={JSON.stringify(routes)}
  aria-label="Search Star Atlas"
  class="cmd-palette"
>
  <div class="cmd-shell">
    <div class="cmd-head">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="cmd-search-icon">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <label for="cmdk-input" class="sr-only">Search notes, sections, tags, or commands</label>
      <input
        id="cmdk-input"
        data-cmdk-input
        type="search"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls="cmdk-list"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search notes, sections, #tags, or >commands…"
        class="cmd-input"
      />
      <button type="button" data-cmdk-clear class="cmd-clear" aria-label="Clear search" hidden>×</button>
      <button type="button" data-cmdk-close class="cmd-esc" aria-label="Close search"><kbd>ESC</kbd></button>
    </div>

    <div class="cmd-scopes" role="tablist" aria-label="Search scope">
      <button type="button" role="tab" class="cmd-scope is-active" data-cmdk-scope="all" aria-selected="true">All</button>
      <button type="button" role="tab" class="cmd-scope" data-cmdk-scope="posts" aria-selected="false">Notes</button>
      <button type="button" role="tab" class="cmd-scope" data-cmdk-scope="headings" aria-selected="false">Sections</button>
      <button type="button" role="tab" class="cmd-scope" data-cmdk-scope="tags" aria-selected="false">Tags</button>
      <button type="button" role="tab" class="cmd-scope" data-cmdk-scope="actions" aria-selected="false">Navigate</button>
    </div>

    <div id="cmdk-list" data-cmdk-list role="listbox" aria-label="Search results" class="cmd-results"></div>

    <div class="cmd-foot">
      <span class="cmd-hints" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>Tab</kbd> scope</span>
        <span><kbd>#</kbd> tags</span>
        <span><kbd>&gt;</kbd> commands</span>
      </span>
      <span data-cmdk-status class="cmd-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

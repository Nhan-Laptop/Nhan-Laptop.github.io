---
import { url, SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-line">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="flex flex-col gap-4">
      <p class="max-w-sm text-2xl font-medium leading-tight tracking-[-0.03em]">
        Notes from somewhere between a <span class="accent text-star">CTF scoreboard</span> and a lattice.
      </p>
      <p class="text-sm text-dim">© {year} {SITE.author}. Built with Astro, Tailwind and Three.js.</p>
    </div>
    <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
      <span class="eyebrow mb-2">Explore</span>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/categories/learning.html')}>Learning</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/categories/writeup.html')}>Writeups</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/categories/project.html')}>Projects</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/categories/life.html')}>Life</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/universe.html')}>Universe map</a>
    </nav>
    <div class="flex flex-col gap-2 text-sm">
      <span class="eyebrow mb-2">Elsewhere</span>
      <a class="link-underline w-fit text-mist hover:text-ink" href={SITE.github} rel="noopener">GitHub ↗</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/rss.xml')}>RSS feed</a>
      <a class="link-underline w-fit text-mist hover:text-ink" href={url('/tags/index.html')}>All tags</a>
    </div>
  </div>
</footer>
